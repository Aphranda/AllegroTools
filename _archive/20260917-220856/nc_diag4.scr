skill (setq apt_netPowUsed nil)
skill (setq apt_netPowGreyIdx 0)
skill (printf "S1 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "S2 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "S3 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "S4 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "S5 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "S6 %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (setq apt_netPowUsed nil)
skill (setq apt_netPowGreyIdx 0)
skill (printf "G1 %L\n" (errset (apt_netPowPick (quote gnd)) t))
skill (printf "G2 %L\n" (errset (apt_netPowPick (quote gnd)) t))
skill (printf "G3 %L\n" (errset (apt_netPowPick (quote gnd)) t))
skill (printf "V1 %L\n" (errset (apt_netPowClass "3V3") t))
skill (printf "V2 %L\n" (errset (apt_netPowClass "12V") t))
skill (printf "V3 %L\n" (errset (apt_netPowClass "5V0") t))
exit
