skill (setq poport (outfile "D:/Aphranda/APTools/Temp/nc_diag.txt" "w"))
skill (printf "ilinit ran? apt_home=%L\n" (errset apt_home nil))
skill (printf "fn bound? apt_netPowClass=%L apt_nosep=%L apt_patAny=%L apt_voltFind=%L\n" (errset (if apt_netPowClass t nil) nil) (errset (if apt_nosep t nil) nil) (errset (if apt_patAny t nil) nil) (errset (if apt_voltFind t nil) nil))
skill (printf "apt_nosep GND      = %L\n" (errset (apt_nosep "GND_1") t))
skill (printf "tables GndKw       = %L\n" (errset apt_netPowGndKw t))
skill (printf "apt_patAny GND/GND = %L\n" (errset (apt_patAny "GND" apt_netPowGndKw) t))
skill (printf "apt_netPowClass GND= %L\n" (errset (apt_netPowClass "GND") t))
skill (printf "apt_netPowClass 3V3= %L\n" (errset (apt_netPowClass "3V3") t))
skill (printf "apt_voltFind 3V3   = %L\n" (errset (apt_voltFind "3V3") t))
skill (printf "apt_netSeed        = %L\n" (errset (apt_netSeed) t))
skill (printf "apt_rnd 100        = %L\n" (errset (apt_rnd 100) t))
skill (printf "apt_netPowPick pwr = %L\n" (errset (apt_netPowPick (quote pwr)) t))
skill (printf "apt_netPowPick gnd = %L\n" (errset (apt_netPowPick (quote gnd)) t))
skill (close poport)
exit
